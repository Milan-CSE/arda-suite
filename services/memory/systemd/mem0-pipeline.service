[Unit]
Description=mem0-local Autonomous Maintenance & Consolidation Pipeline (Dream Daemon)
After=network.target mem0-mcp.service

[Service]
Type=oneshot
User=@MEM0_USER@
WorkingDirectory=@MEM0_DIR@
EnvironmentFile=-%h/.mem0/config.env
ExecStart=@MEM0_DIR@/.venv/bin/python @MEM0_DIR@/pipeline.py
StandardOutput=journal
StandardError=journal
